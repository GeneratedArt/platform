{
  "name": "@generatedart/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "build:client": "esbuild client/auth.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-auth.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:dashboard": "esbuild client/dashboard.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-dashboard.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:studio": "esbuild client/studio.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-studio.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:profile": "esbuild client/profile.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-profile.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:project-detail": "esbuild client/project-detail.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-project-detail.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:profile-editor": "esbuild client/profile-editor.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-profile-editor.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:mint": "esbuild client/mint.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-mint.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:briefs": "esbuild client/briefs.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-briefs.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:explore": "esbuild client/explore.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-explore.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:search": "esbuild client/search.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-search.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:feed": "esbuild client/feed.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-feed.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:token-detail": "esbuild client/token-detail.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-token-detail.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:all": "npm run build:client && npm run build:dashboard && npm run build:studio && npm run build:profile && npm run build:project-detail && npm run build:profile-editor && npm run build:mint && npm run build:briefs && npm run build:explore && npm run build:search && npm run build:feed && npm run build:token-detail",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:prod": "wrangler d1 migrations apply DB --env production --remote"
  },
  "dependencies": {
    "hono": "^4.12.16",
    "siwe": "^2.3.2",
    "viem": "^2.48.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "codemirror": "^6.0.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.6"
  }
