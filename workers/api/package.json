{
  "name": "@generatedart/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "build:client": "esbuild client/auth.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-auth.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:dashboard": "esbuild client/dashboard.ts --bundle --format=esm --target=es2020 --minify --sourcemap=linked --outfile=../../assets/js/ga-dashboard.js --define:process.env.NODE_ENV=\\\"production\\\" --tree-shaking=true",
    "build:all": "npm run build:client && npm run build:dashboard",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:prod": "wrangler d1 migrations apply DB --env production --remote"
  },
  "dependencies": {
    "hono": "^4.12.16",
    "siwe": "^2.3.2",
    "viem": "^2.48.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.6"
  }
}
