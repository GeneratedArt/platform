# Copy this file to `.dev.vars` (gitignored) before running `npx wrangler dev`.
# These three values are read as Worker bindings during local development.

# Long random string used to sign session JWTs. Regenerate per developer:
#   openssl rand -hex 32
JWT_SECRET="replace-me-with-openssl-rand-hex-32"

# Cookie domain for local dev. Use "localhost" when serving the Jekyll site
# at http://localhost:5000. In production this is ".generatedart.com" so the
# session cookie is shared between root and api subdomains.
COOKIE_DOMAIN="localhost"

# Comma-separated list of origins allowed to make credentialed requests to the
# Worker AND allowed in the SIWE message `domain` field.
ALLOWED_ORIGINS="http://localhost:5000,http://127.0.0.1:5000"

# --- GitHub (Task #3 — Repo-as-Project) ------------------------------------
# Production: store as a wrangler secret (NEVER commit a real PAT):
#   wrangler secret put GITHUB_PAT --env production
# A fine-grained, org-scoped token with the following permissions on
# `GeneratedArt-artists`: Contents R/W, Administration R/W (for create-from-
# template), Metadata R/O.
GITHUB_PAT=""

# Org under which artist project repos are created.
GITHUB_ORG="GeneratedArt-artists"

# Template repo (owner/name) used as the source for `Use this template`.
GITHUB_TEMPLATE_REPO="GeneratedArt-artists/template-sketch"

# OPT-IN ONLY. When set to exactly "1", the Worker skips real GitHub API
# calls and returns a stub repo response — useful for local smoke tests
# without burning rate limit. A missing GITHUB_PAT does NOT enable mock
# mode; in non-mock mode the Worker fails closed with 503
# `github_pat_unconfigured`. Production must NEVER set GITHUB_MOCK.
GITHUB_MOCK="1"
