---
import AppLayout from "../../layouts/AppLayout.astro";
import MintIsland from "../../components/MintIsland.tsx";
const { slug } = Astro.params;
---
<AppLayout title={`Mint — ${slug} — GeneratedArt`}>
  <section class="container page-head">
    <p class="eyebrow">Mint</p>
    <h1 class="h-display" id="mint-title">{slug}</h1>
    <p class="page-head__sub" id="mint-sub">Connect a wallet to mint a deterministic, on-chain edition. Every render is fully reproducible from its token hash.</p>
  </section>

  <section class="container section">
    <div class="grid" style="grid-template-columns:1.4fr 1fr;gap:clamp(1rem,2vw,2rem);align-items:start">
      <MintIsland slug={slug!} client:load />
    </div>
  </section>
</AppLayout>
