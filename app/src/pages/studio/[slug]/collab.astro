---
import AppLayout from "~/layouts/AppLayout.astro";
import CollabInviteIsland from "~/components/CollabInviteIsland.tsx";
export const prerender = false;
const { slug } = Astro.params as { slug: string };
---
<AppLayout title={`Collaborators — ${slug} — GeneratedArt`}>
  <section class="container page-head">
    <p class="eyebrow"><a href="/studio">← Studio</a> · <span class="mono">{slug}</span></p>
    <h1 class="h-display">Collaborators</h1>
    <p class="page-head__sub">Every collaboration is on-chain. Invite a wallet, set a revenue share,
      and sign an EIP-712 message. Once they counter-sign the agreement is active and immutable.</p>
  </section>
  <section class="container section">
    <CollabInviteIsland client:load slug={slug} />
  </section>
</AppLayout>
