---
import AppLayout from "../../layouts/AppLayout.astro";
---
<AppLayout title="Studio — GeneratedArt">
  <section class="container page-head">
    <p class="eyebrow">Artist studio</p>
    <h1 class="h-display">Studio</h1>
    <p class="page-head__sub">Your projects in one place — drafts, in-review, live, and sold-out.
      Each project is a real GitHub repository under <span class="mono">GeneratedArt/</span>.</p>
  </section>

  <section class="container section" id="studio-root">
    <p class="muted" data-loading>Loading your projects…</p>
  </section>
</AppLayout>

<script type="module">
  import { apiFetch, RENDERER_BASE, SITE_BASE } from "~/lib/api.ts";
  import { loadMe, startGithubLogin } from "~/lib/session.ts";

  const root = document.getElementById("studio-root");
  function html(strings, ...vals) {
    const s = String.raw({ raw: strings }, ...vals.map((v) => v == null ? "" : String(v)));
    const t = document.createElement("template"); t.innerHTML = s.trim();
    return t.content;
  }
  function escape(s) { return String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c])); }
  function pillClass(s) { return ({ draft:"pill--draft", in_review:"pill--review", approved:"pill--approved", live:"pill--live", published:"pill--live", "sold-out":"pill--sold-out" })[s] || ""; }

  (async () => {
    const me = await loadMe().catch(() => null);
    if (!me) {
      root.replaceChildren(html`
        <div class="card" style="max-width:520px">
          <h2 class="h-section">Sign in to continue</h2>
          <p class="muted">The studio is only available to verified artists.</p>
          <button class="btn" id="ga-signin">Sign in with GitHub</button>
        </div>`);
      document.getElementById("ga-signin").onclick = () => startGithubLogin("/studio");
      return;
    }
    if (me.role !== "artist" && me.role !== "curator" && me.role !== "steward") {
      root.replaceChildren(html`
        <div class="card" style="max-width:520px">
          <h2 class="h-section">You're not an artist yet</h2>
          <p class="muted">Apply via the public site to join the platform.</p>
          <a class="btn" href="${escape(SITE_BASE)}/apply">Open application</a>
        </div>`);
      return;
    }

    let res;
    try { res = await apiFetch("/me/projects"); }
    catch (e) {
      root.replaceChildren(html`<p class="error">Couldn't load your projects: ${escape(e.message)}</p>`);
      return;
    }
    const projects = (res?.projects ?? []);
    const grouped = { draft: [], in_review: [], approved: [], live: [], "sold-out": [] };
    for (const p of projects) {
      const k = (p.status || "draft");
      (grouped[k] ?? grouped.draft).push(p);
    }

    root.innerHTML = "";
    root.appendChild(html`
      <div class="row row--between" style="margin-bottom:2rem">
        <h2 class="h-section" style="margin:0">${escape(projects.length)} project${projects.length === 1 ? "" : "s"}</h2>
        <a class="btn" href="/studio/new">New project</a>
      </div>`);

    if (projects.length === 0) {
      root.appendChild(html`<p class="muted">You haven't started a project yet. Click <strong>New project</strong> to spin up a repo.</p>`);
      return;
    }

    const sectionFor = (key, label) => {
      const items = grouped[key] || [];
      if (items.length === 0) return;
      const sec = document.createElement("section");
      sec.style.marginTop = "2.5rem";
      sec.appendChild(html`<h3 class="eyebrow">${escape(label)} · ${items.length}</h3>`);
      const grid = document.createElement("div"); grid.className = "grid";
      for (const p of items) {
        const minted = p.minted ?? 0, size = p.edition_size ?? 1;
        const pct = Math.min(100, Math.round((minted / size) * 100));
        const repoLink = p.repo_url ? `<a href="${escape(p.repo_url)}" target="_blank" rel="noopener" class="mono subtle" style="font-size:.78rem">repo →</a>` : "";
        grid.appendChild(html`
          <article class="card">
            <div class="card__media">
              ${p.bundle_cid
                ? `<iframe src="${escape(RENDERER_BASE)}/render?cid=${escape(p.bundle_cid)}&hash=0xdeadbeefcafebabefeedfacedeadbeefcafebabefeedfacedeadbeefcafebabe&res=512x512" sandbox="allow-scripts allow-pointer-lock" loading="lazy" title="${escape(p.title)}"></iframe>`
                : `<div style="display:grid;place-items:center;height:100%;color:var(--fg-subtle);font-size:.85rem">No bundle yet</div>`}
            </div>
            <div class="row row--between">
              <h4 class="card__title" style="font-size:1.05rem">${escape(p.title)}</h4>
              <span class="pill ${pillClass(p.status)}">${escape((p.status || "draft").replace("_", " "))}</span>
            </div>
            <div class="row row--between mono subtle" style="font-size:.75rem">
              <span>${minted} / ${size} minted</span>
              <span>${pct}%</span>
            </div>
            <span class="progress"><span class="progress__bar" style="width:${pct}%"></span></span>
            <div class="row" style="gap:.5rem">
              <a class="btn btn--ghost btn--small" href="${escape(SITE_BASE)}/projects/${escape(p.slug)}/" target="_blank" rel="noopener">View</a>
              ${repoLink}
            </div>
          </article>`);
      }
      sec.appendChild(grid);
      root.appendChild(sec);
    };

    sectionFor("live", "Live");
    sectionFor("approved", "Approved · ready to publish");
    sectionFor("in_review", "In review");
    sectionFor("draft", "Drafts");
    sectionFor("sold-out", "Past");
  })();
</script>
