---
import AppLayout from "../layouts/AppLayout.astro";
const apiBase = (import.meta as any).env?.PUBLIC_API_BASE ?? "https://api.generatedart.com";
---
<AppLayout title="GeneratedArt — App">
  <section class="container section">
    <p class="eyebrow">App · app.generatedart.com</p>
    <h1 class="h-display">Studio, mint, <em>collect</em>.</h1>
    <p class="lede" style="margin-top:1.25rem">
      The interactive surface for GeneratedArt. Sign in with GitHub to access the artist
      studio, connect a wallet to mint and collect, or use the curator console if your
      role allows it.
    </p>

    <div class="grid" style="margin-top:3rem;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))">
      <a href="/studio" class="card" style="border-color:var(--rule);text-decoration:none">
        <span class="eyebrow">Artists</span>
        <h2 class="card__title">Studio</h2>
        <p class="muted" style="margin:0">Manage your projects, repos, releases, and earnings.</p>
      </a>
      <a href="/dashboard" class="card" style="border-color:var(--rule);text-decoration:none">
        <span class="eyebrow">Collectors</span>
        <h2 class="card__title">Dashboard</h2>
        <p class="muted" style="margin:0">Your holdings, watchlist, and activity.</p>
      </a>
      <a href="/admin" class="card" style="border-color:var(--rule);text-decoration:none">
        <span class="eyebrow">Curators</span>
        <h2 class="card__title">Console</h2>
        <p class="muted" style="margin:0">Pending applications, project reviews, and flags.</p>
      </a>
      <a href="/exhibitions/new" class="card" style="border-color:var(--rule);text-decoration:none">
        <span class="eyebrow">Galleries</span>
        <h2 class="card__title">New exhibition</h2>
        <p class="muted" style="margin:0">Curate and publish a steward-led exhibition.</p>
      </a>
    </div>

    <p class="mono subtle" style="margin-top:3rem;font-size:.78rem">API: {apiBase}</p>
  </section>
</AppLayout>
