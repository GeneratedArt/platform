---
import AppLayout from "../../layouts/AppLayout.astro";
---
<AppLayout title="New exhibition — GeneratedArt">
  <section class="container page-head">
    <p class="eyebrow">Galleries · steward flow</p>
    <h1 class="h-display">New exhibition</h1>
    <p class="page-head__sub">Curate a public exhibition under a partner gallery. You must be the gallery's steward to publish.</p>
  </section>

  <section class="container section">
    <div id="exh-root"><p class="muted">Loading…</p></div>
  </section>
</AppLayout>

<script type="module">
  import { apiFetch } from "~/lib/api.ts";
  import { loadMe, startGithubLogin } from "~/lib/session.ts";

  const root = document.getElementById("exh-root");
  function escape(s) { return String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c])); }

  (async () => {
    const me = await loadMe().catch(() => null);
    if (!me) {
      root.innerHTML = `<div class="card" style="max-width:520px"><h2 class="h-section">Sign in</h2><button class="btn" id="b">Sign in with GitHub</button></div>`;
      document.getElementById("b").onclick = () => startGithubLogin("/exhibitions/new");
      return;
    }
    if (me.role !== "gallery" && me.role !== "steward" && me.role !== "curator") {
      root.innerHTML = `<p class="error">Only gallery stewards and curators can create exhibitions.</p>`;
      return;
    }

    let galleries = [];
    try { galleries = (await apiFetch("/galleries"))?.galleries || []; } catch { galleries = []; }

    root.innerHTML = `
      <form id="exh" class="form card" style="max-width:680px">
        <label class="field">
          <span>Gallery</span>
          ${galleries.length
            ? `<select name="gallery_slug" required>${galleries.map((g) => `<option value="${escape(g.slug)}">${escape(g.name)}${g.location ? ` — ${escape(g.location)}` : ""}</option>`).join("")}</select>`
            : `<input name="gallery_slug" required pattern="[a-z0-9-]+" placeholder="geneva" />`}
          <small>If your gallery isn't listed, it must be registered first by a steward.</small>
        </label>
        <label class="field">
          <span>Exhibition title</span>
          <input name="title" required minlength="2" maxlength="120" placeholder="Stochastic Geometries" />
        </label>
        <label class="field">
          <span>Curator note</span>
          <textarea name="note" rows="4" maxlength="2000" placeholder="A short curatorial statement (markdown allowed)."></textarea>
        </label>
        <div class="grid" style="grid-template-columns:1fr 1fr;gap:1rem">
          <label class="field">
            <span>Opens</span>
            <input name="starts_at" type="datetime-local" required />
          </label>
          <label class="field">
            <span>Closes</span>
            <input name="ends_at" type="datetime-local" required />
          </label>
        </div>
        <label class="field">
          <span>Featured project slugs</span>
          <input name="project_slugs" placeholder="random-walks, vellum, calque" required />
          <small>Comma-separated. Each must be a live project. We resolve them to project IDs before publishing.</small>
        </label>
        <p class="error" id="err" hidden></p>
        <div class="row">
          <button class="btn" type="submit" id="submit">Publish exhibition</button>
          <a class="btn btn--ghost" href="/dashboard">Cancel</a>
        </div>
      </form>`;

    const form = document.getElementById("exh");
    const err = document.getElementById("err");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      err.hidden = true;
      const fd = new FormData(form);
      const slugs = String(fd.get("project_slugs") || "").split(",").map((s) => s.trim()).filter(Boolean);
      const gallerySlug = fd.get("gallery_slug");
      const submit = document.getElementById("submit");
      submit.disabled = true; submit.textContent = "Publishing…";
      try {
        // Resolve slug → project id by hitting the public catalogue once.
        const live = (await apiFetch("/projects", { auth: false }))?.projects || [];
        const byslug = new Map(live.map((p) => [p.slug, p.id]));
        const project_ids = slugs.map((s) => byslug.get(s)).filter(Boolean);
        const missing = slugs.filter((s) => !byslug.has(s));
        if (missing.length || project_ids.length === 0) {
          throw new Error(`Unknown or non-live project slug: ${missing.join(", ") || "(none provided)"}`);
        }
        const body = {
          title: fd.get("title"),
          starts_at: Math.floor(new Date(String(fd.get("starts_at"))).getTime() / 1000),
          ends_at: Math.floor(new Date(String(fd.get("ends_at"))).getTime() / 1000),
          project_ids,
        };
        await apiFetch(`/galleries/${gallerySlug}/exhibitions`, { method: "POST", body: JSON.stringify(body) });
        location.href = "/dashboard?exhibition=ok";
      } catch (e2) {
        err.textContent = e2.message || "Couldn't publish the exhibition.";
        err.hidden = false;
        submit.disabled = false; submit.textContent = "Publish exhibition";
      }
    });
  })();
</script>
