---
import AppLayout from "../layouts/AppLayout.astro";
---
<AppLayout title="Dashboard — GeneratedArt">
  <section class="container page-head">
    <p class="eyebrow">Collector</p>
    <h1 class="h-display">Dashboard</h1>
    <p class="page-head__sub">Your wallet's holdings on Base, plus links to your studio if you're an artist.</p>
  </section>

  <section class="container section">
    <div id="dash-root"><p class="muted">Loading…</p></div>
  </section>
</AppLayout>

<script type="module">
  import { apiFetch } from "~/lib/api.ts";
  import { loadMe, startGithubLogin } from "~/lib/session.ts";

  const root = document.getElementById("dash-root");
  function escape(s) { return String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c])); }

  (async () => {
    const me = await loadMe().catch(() => null);
    if (!me) {
      root.innerHTML = `<div class="card" style="max-width:520px">
        <h2 class="h-section">Sign in to see your dashboard</h2>
        <button class="btn" id="b">Sign in with GitHub</button>
      </div>`;
      document.getElementById("b").onclick = () => startGithubLogin("/dashboard");
      return;
    }

    const wallet = me.wallet_address;
    const cards = [];
    cards.push(`
      <article class="card">
        <span class="eyebrow">You</span>
        <h2 class="h-section" style="margin:0">${escape(me.display_name || me.github_login || "Account")}</h2>
        <div class="row" style="gap:.5rem">
          <span class="pill">${escape(me.role)}</span>
          ${wallet ? `<span class="mono subtle" style="font-size:.78rem">${escape(wallet.slice(0,6) + "…" + wallet.slice(-4))}</span>` : `<span class="muted" style="font-size:.85rem">No wallet linked</span>`}
        </div>
        ${me.role === "artist" ? `<a class="btn btn--ghost btn--small" href="/studio">Open studio →</a>` : ""}
        ${me.role === "curator" || me.role === "steward" ? `<a class="btn btn--ghost btn--small" href="/admin">Open admin →</a>` : ""}
      </article>`);

    if (wallet) {
      cards.push(`
        <article class="card">
          <span class="eyebrow">Holdings</span>
          <h2 class="h-section" style="margin:0">Your collection</h2>
          <p class="muted" id="hold-count">…</p>
          <a class="btn btn--ghost btn--small" href="/collect/${escape(wallet)}">Browse all →</a>
        </article>`);
    } else {
      cards.push(`
        <article class="card">
          <span class="eyebrow">Wallet</span>
          <h2 class="h-section" style="margin:0">Connect a wallet</h2>
          <p class="muted">Link a wallet to see your collection and mint editions.</p>
          <button class="btn" id="connect-wallet">Connect wallet</button>
        </article>`);
    }

    root.innerHTML = `<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">${cards.join("")}</div>`;

    if (wallet) {
      try {
        const r = await apiFetch(`/owners/${wallet}/editions`, { auth: false });
        const n = (r?.editions || []).length;
        document.getElementById("hold-count").textContent = `${n} edition${n === 1 ? "" : "s"} held`;
      } catch { document.getElementById("hold-count").textContent = "—"; }
    } else {
      document.getElementById("connect-wallet")?.addEventListener("click", async () => {
        if (!window.ethereum) { alert("No EIP-1193 wallet detected."); return; }
        try {
          const [a] = await window.ethereum.request({ method: "eth_requestAccounts" });
          // SIWE flow: ask the worker for a nonce, sign, post back. We assume
          // the API exposes /auth/siwe/nonce; fall back gracefully if not.
          let nonce;
          try { ({ nonce } = await apiFetch("/auth/siwe/nonce", { method: "POST", body: JSON.stringify({ address: a }), auth: false })); }
          catch { nonce = crypto.randomUUID(); }
          const domain = location.host;
          const issued = new Date().toISOString();
          const message = `${domain} wants you to sign in with your Ethereum account:\n${a}\n\nGeneratedArt session.\n\nURI: ${location.origin}\nVersion: 1\nChain ID: 8453\nNonce: ${nonce}\nIssued At: ${issued}`;
          const sig = await window.ethereum.request({ method: "personal_sign", params: [message, a] });
          const verify = await apiFetch("/auth/siwe/verify", { method: "POST", body: JSON.stringify({ message, signature: sig }), auth: false });
          if (verify?.token) { localStorage.setItem("ga.session_token", verify.token); location.reload(); }
        } catch (e) { alert(e.message || "Wallet sign-in failed"); }
      });
    }
  })();
</script>
